data/corpus/
*.db
*.db-journal
config/settings.yaml
qi/config/settings.yaml

.qoder
# Cursor：忽略本地状态，保留可共享的 rules
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
# PyInstaller 中间产物（打脑脚本会再生成）
qi-brain.spec
.pytest_cache/
# pytest --basetemp 若指到仓库内，勿提交
.pytest_basetemp/
.pytest_basetemp*/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/

# 前端（Vue / Vite / Tauri）
node_modules/
qi/embodiment/desktop/dist/
qi/embodiment/desktop/.vite/
qi/embodiment/desktop/src-tauri/target/
# P3：PyInstaller 大脑 onedir + 安装用 zip（由 tools/build_qi_brain.py 生成）
qi/embodiment/desktop/src-tauri/resources/qi-brain/**
!qi/embodiment/desktop/src-tauri/resources/qi-brain/README.md
qi/embodiment/desktop/src-tauri/resources/qi-brain.zip
# P3：BGE 离线资源（由 tools/fetch_bge_resource.py 生成）
qi/embodiment/desktop/src-tauri/resources/bge-small-zh-v1.5/**
!qi/embodiment/desktop/src-tauri/resources/bge-small-zh-v1.5/README.md
