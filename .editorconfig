# https://editorconfig.org — 与 .gitattributes 的 eol=lf 对齐
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{ts,tsx,vue,js,mjs,cjs,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
